# Required
DATABASE_URL=mysql://journal:change-this-password@127.0.0.1:3306/journal_server

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# At least 16 bytes. Used in the X-Admin-Token header for pack publishing.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Listener. Use 127.0.0.1:8965 when the reverse proxy runs on the same host.
BIND_ADDR=0.0.0.0:8965

# WebAuthn relying party. RP_ID must be the origin's registrable domain.
RP_ID=journal.xiaoxinww.xin
RP_ORIGIN=https://journal.xiaoxinww.xin

# Pack files and icons live here.
DATA_DIR=./data

# Optional limits (bytes).
MAX_JOURNAL_BYTES=26214400
MAX_PACK_BYTES=104857600
MAX_AVATAR_BYTES=2097152

# Comma-separated SHA-256 signing-certificate fingerprints (with or without
# colons). Both debug and release certificates may be listed. REQUIRED for
# Android App Links and native passkeys; replace with the real release
# fingerprint before publishing.
ANDROID_APP_CERT_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99